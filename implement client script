function onChange(control, oldValue, newValue, isLoading) {
    if (isLoading || newValue === '') {
        return;
    }

    // Impact: 1 = High, 2 = Medium, 3 = Low
    if (newValue == '1') {
        g_form.setValue('urgency', '1');
    } else if (newValue == '2') {
        g_form.setValue('urgency', '2');
    } else if (newValue == '3') {
        g_form.setValue('urgency', '3');
    }
}
